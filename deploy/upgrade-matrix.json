{
  "schema_version": 1,
  "policy": {
    "fresh_install": {
      "decision": "allow",
      "requires_empty_target": true
    },
    "legacy_internal_installation": {
      "decision": "deny",
      "status": "retired"
    },
    "unknown_source": {
      "decision": "deny"
    },
    "unlisted_upgrade": {
      "decision": "deny"
    }
  },
  "upgrade_paths": []
}

# Copy this file to .env only when your process manager loads dotenv files.
# The Python application reads environment variables; it does not load .env
# automatically.

PLATFORM_CONFIG_PATH=./config.json
PLATFORM_AUTH_ENABLED=false
PLATFORM_COOKIE_SECURE=false

# Secrets are accepted only from process environment variables.
# Legacy plaintext fields in config.json are ignored and require migration.
PLATFORM_SESSION_SECRET=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_DB_PASSWORD=
OPENCODE_SERVER_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Optional Compose listener overrides.
PLATFORM_BIND_ADDRESS=127.0.0.1
PLATFORM_PORT=5000

# Execution is intentionally disabled by default. The published Compose stack
# keeps host setup scripts disabled; a custom trusted deployment must opt in.
PLATFORM_ALLOW_HOST_SCRIPT_EXECUTION=false
PLATFORM_ALLOW_TEST_EXECUTION=false

# The model sees these variable names, never their values.
TARGET_SYSTEM_USERNAME=
TARGET_SYSTEM_PASSWORD=

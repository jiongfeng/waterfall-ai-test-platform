# Copy this file to .env only when your process manager loads dotenv files.
# The Python application reads environment variables; it does not load .env
# automatically.

PLATFORM_CONFIG_PATH=./config.json
PLATFORM_AUTH_ENABLED=false
PLATFORM_COOKIE_SECURE=false

# Compose uses these values to initialize or authenticate its services.
# Copy PLATFORM_DB_PASSWORD and OPENCODE_SERVER_PASSWORD into the matching
# password fields of the local config.json; the application reads those two
# passwords from JSON. Keep both files permission-restricted and untracked.
COMPOSE_PROJECT_NAME=waterfall-ai-test-platform
PLATFORM_SESSION_SECRET=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_DB_PASSWORD=
OPENCODE_SERVER_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Optional Compose listener overrides.
PLATFORM_BIND_ADDRESS=127.0.0.1
PLATFORM_PORT=5000

# The bundled demo deployment opts in to execution. Set either value to false
# for deployments where arbitrary setup scripts or generated Playwright tests
# must not run.
PLATFORM_ALLOW_HOST_SCRIPT_EXECUTION=true
PLATFORM_ALLOW_TEST_EXECUTION=true
